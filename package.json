{
  "name": "cv-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @cv-studio/web dev",
    "dev:api": "pnpm --filter @cv-studio/api dev",
    "build": "tsc -b && pnpm --filter @cv-studio/web build",
    "preview": "pnpm --filter @cv-studio/web preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "cv": "pnpm -s --filter @cv-studio/api cv",
    "setup:pdf": "pnpm --filter @cv-studio/api exec playwright install chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cv-studio/core": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.16.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
